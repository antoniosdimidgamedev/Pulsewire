{
  "name": "pulsewire",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-net --allow-run src/main.ts",
    "dev": "deno run --allow-read --allow-write --allow-env --allow-sys --allow-net src/main.ts --demo",
    "test": "deno test --allow-read --allow-write --allow-env --allow-sys tests/",
    "check": "deno check src/main.ts scripts/preview.ts tests/",
    "lint": "deno lint src tests scripts",
    "fmt": "deno fmt src tests scripts README.md config.example.json deno.json",
    "fmt:check": "deno fmt --check src tests scripts README.md config.example.json deno.json",
    "preview": "deno run --allow-read --allow-write --allow-env --allow-sys scripts/preview.ts",
    "compile:linux": "deno compile --allow-read --allow-write --allow-env --allow-sys --allow-net --allow-run --target x86_64-unknown-linux-gnu --output dist/pulsewire-linux src/main.ts",
    "compile:windows": "deno compile --allow-read --allow-write --allow-env --allow-sys --allow-net --allow-run --target x86_64-pc-windows-msvc --output dist/pulsewire.exe src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "newLineKind": "lf"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-control-regex"]
    }
  }
}
