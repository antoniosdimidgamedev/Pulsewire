<?xml version="1.0" encoding="utf-8"?>
<!--
  Trusted-LAN builds allow plain HTTP so a Pulsewire server can be reached by
  its private address. Use HTTPS for any network you do not control.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
