<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="pulse_background">#FF0D1514</color>
    <color name="pulse_primary">#FF5EEAD4</color>
    <color name="pulse_status_bar">#FF0D1514</color>

    <style name="Theme.Pulsewire" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pulse_background</item>
        <item name="android:statusBarColor">@color/pulse_status_bar</item>
        <item name="android:navigationBarColor">@color/pulse_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/pulse_primary</item>
    </style>
</resources>
